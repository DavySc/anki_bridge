# Copy to /srv/anki-bridge/env, chmod 600, owner anki. Names only: put real values on the VPS,
# never in this repository.

# Public origin, https, no path. Used as the OAuth issuer.
PUBLIC_URL=https://anki.panzeilkamp.com

# From `nix develop --command python auth.py hash` (prompts for the secret you will type at login).
OWNER_SECRET_HASH=REPLACE_ME

# Behind nginx: take the client IP from the last X-Forwarded-For entry.
TRUST_PROXY=1

# Loopback only. 8000 is used by the other site on this host.
HOST=127.0.0.1
PORT=8765

DATA_DIR=/srv/anki-bridge/data

# AnkiWeb login. Leave both out to run with sync off.
ANKIWEB_USER=
ANKIWEB_PASS=

# Never set ALLOW_INSECURE_NO_AUTH here.
